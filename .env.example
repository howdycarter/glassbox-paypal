# PayPal Sandbox credentials — server-side only, never shipped to the browser.
# Create them at https://developer.paypal.com/dashboard/applications/sandbox
# (log in with the entrant's PayPal account -> Apps & Credentials -> Sandbox -> Create App).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox default. Live would be https://api-m.paypal.com — this project targets the sandbox only.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PORT=8787
